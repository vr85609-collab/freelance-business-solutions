# Use Render secret environment variables. Never commit real values.
DATABASE_URL=
APP_ORIGIN=https://aquaemoticons-play-win.onrender.com
SHOPIFY_SHOP=c4f975-da.myshopify.com
SHOPIFY_API_SECRET=
# For new Dev Dashboard apps: client ID + client secret above; tokens refresh automatically.
SHOPIFY_CLIENT_ID=
# Optional legacy installed app token; leave blank when using client credentials.
SHOPIFY_ADMIN_ACCESS_TOKEN=
ARCADE_FRAUD_SALT=
ARCADE_ADMIN_TOKEN=
# Enable only after production identity/checkout/security tests and terms review.
ARCADE_REWARDS_ENABLED=false
ARCADE_PROMOTION_TERMS_APPROVED=false
# Comma-separated full Shopify ProductVariant GIDs, approved as your private-label products.
GIFT_VARIANT_ALLOWLIST=gid://shopify/ProductVariant/44033465483460,gid://shopify/ProductVariant/44033448804548,gid://shopify/ProductVariant/44033428324548
MAX_GIFT_VALUE_USD=6
MAX_GIFTS_PER_30_DAYS=3
MAX_COUPONS_PER_WEEK=10
# Conservative estimates; verify actual fees, packaging and any free-shipping subsidy before activation.
ARCADE_PAYMENT_FEE_PERCENT=4
ARCADE_PAYMENT_FEE_FIXED_USD=0.30
ARCADE_PACKAGING_USD=1.50
ARCADE_SHIPPING_SUBSIDY_USD=0
ARCADE_MIN_CONTRIBUTION_USD=5
